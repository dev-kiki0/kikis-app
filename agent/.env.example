# ── Reference agent (agent/src/index.ts) ──────────────────────────────────────
# These are the ONLY variables read by the reference runner.

# Stellar network: 'testnet' (default) or 'mainnet'
STELLAR_NETWORK=testnet

# Agent keypair secret (S...). Required.
AGENT_SECRET=S...

# Local daily spend cap for policy rejection demo
# Must be > x402_price (0.001) + mpp_charge_price (0.0008) = 0.0018
# and < 0.0018 + x402_price (0.001) = 0.0028  → policy fires on step 5
AGENT_DAILY_CAP_USDC=0.002

# Provider URLs — override for local, staging, or deployed instances
PROVIDER_A_URL=http://localhost:3001
PROVIDER_B_URL=http://localhost:3002

# Optional: commitment secret for MPP session commitments
# COMMITMENT_SECRET=S...

# Optional: where the spend store persists (defaults to ~/.kikis-app/spend.json)
# AGENT_SPEND_STORE_PATH=/path/to/spend.json
# KIKIS_APP_SPEND_STORE_PATH=/path/to/spend.json

# ── Not read by the reference runner ──────────────────────────────────────────
# The following settings are used by other packages/examples, NOT by
# agent/src/index.ts. Setting them here will not change the runner's behavior.
#
# AGENT_VAULT_CONTRACT_ID — used by AgentVault contract examples, not the runner
# SUPABASE_URL / SUPABASE_ANON_KEY — used by other packages, not the runner
